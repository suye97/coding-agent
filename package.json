{
  "name": "feishu-delivery-desktop-app",
  "productName": "需求交付台",
  "version": "0.2.11",
  "private": true,
  "type": "module",
  "description": "独立运行的飞书需求开发、验证与交付桌面应用",
  "main": "dist/electron/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "test": "node --test",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "dist": "npm run build && electron-builder",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@larksuite/channel": "0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "40.10.6",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "local.feishu.delivery.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "scripts/installer.nsh"
    }
  }
}
