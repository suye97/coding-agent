{
  "name": "@local/dsh-feishu-development-agent",
  "version": "0.1.0",
  "description": "Feishu task intake, plan approval, and local development for DeepSeek Harness",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "src", "cordis.patch.yml", "locale", "icon.svg"],
  "scripts": { "test": "node --test" },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@larksuite/channel": "0.7.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
