{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist/electron",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "src/**/*.js"]
}
